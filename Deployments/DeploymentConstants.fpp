module Va416x0 {

    # The purpose of this file to define commonly used constants for deployments

    @ 1 Hz RTI duration in microseconds
    constant RtiDurationMicrosecs1Hz = 1000000/1

    @ 2 Hz RTI duration in microseconds
    constant RtiDurationMicrosecs2Hz = 1000000/2

    @ 8 Hz RTI duration in microseconds
    constant RtiDurationMicrosecs8Hz = 1000000/8
    
    @ 64 Hz RTI duration in microseconds
    constant RtiDurationMicrosecs64Hz = 1000000/64

}
